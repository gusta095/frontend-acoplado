    {
      "id": "oci",
      "name": "Oracle Cloud Infrastructure",
      "shortName": "OCI",
      "logoUrl": "",
      "accentColor": "#C74634",
      "description": "Infraestrutura de alto desempenho com foco em workloads críticos."
    }
  ],
  "offers": [
    {
      "id": "azure-resource-group",
      "providerId": "azure",
      "name": "Resource Group",
      "shortDescription": "Crie um Resource Group no Azure para agrupar recursos com o mesmo ciclo de vida.",
      "longDescription": "## Resource Group\n\nUm **Resource Group** é um contêiner lógico no Azure que agrupa recursos relacionados com o mesmo ciclo de vida, permissões e políticas. É o ponto de partida para qualquer workload no Azure.",
      "category": "other",
      "tags": ["azure", "organizacao", "iac"],
      "estimatedDuration": "~30 segundos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome do Resource Group",
          "type": "string",
          "required": true,
          "placeholder": "rg-meu-projeto-prod",
          "description": "Deve seguir o padrão: rg-{projeto}-{ambiente}",
          "validation": { "pattern": "^rg-[a-z0-9-]+$", "minLength": 5, "maxLength": 64 }
        },
        {
          "key": "location",
          "label": "Região",
          "type": "select",
          "required": true,
          "options": ["brazilsouth", "eastus", "westeurope"],
          "defaultValue": "brazilsouth"
        },
        {
          "key": "environment",
          "label": "Ambiente",
          "type": "select",
          "required": true,
          "options": ["dev", "staging", "prod"]
        }
      ]
    },
    {
      "id": "azure-storage-account",
      "providerId": "azure",
      "name": "Storage Account",
      "shortDescription": "Provisione uma conta de armazenamento Azure para blobs, filas, tabelas e arquivos.",
      "longDescription": "## Storage Account\n\nO **Azure Storage Account** oferece armazenamento durável, seguro e escalável para blobs, filas, tabelas e arquivos. Ideal para dados não estruturados, backups e assets estáticos.",
      "category": "storage",
      "tags": ["azure", "storage", "blob"],
      "estimatedDuration": "~1 minuto",
      "parameters": [
        {
          "key": "name",
          "label": "Nome da Storage Account",
          "type": "string",
          "required": true,
          "placeholder": "stmeuprojetoprod",
          "description": "Somente letras minúsculas e números, 3-24 caracteres.",
          "validation": { "pattern": "^[a-z0-9]{3,24}$", "minLength": 3, "maxLength": 24 }
        },
        {
          "key": "resource_group",
          "label": "Resource Group",
          "type": "string",
          "required": true,
          "placeholder": "rg-meu-projeto-prod"
        },
        {
          "key": "sku",
          "label": "Tipo de Redundância",
          "type": "select",
          "required": true,
          "options": ["LRS", "GRS", "ZRS", "GZRS"],
          "defaultValue": "LRS",
          "description": "LRS = local, GRS = geo-redundante, ZRS = zona-redundante"
        },
        {
          "key": "access_tier",
          "label": "Camada de Acesso",
          "type": "select",
          "required": true,
          "options": ["Hot", "Cool"],
          "defaultValue": "Hot"
        }
      ]
    },
    {
      "id": "azure-virtual-network",
      "providerId": "azure",
      "name": "Virtual Network",
      "shortDescription": "Crie uma rede virtual privada no Azure com controle total sobre endereçamento IP e roteamento.",
      "longDescription": "## Virtual Network\n\nA **Azure Virtual Network (VNet)** permite criar redes privadas isoladas na nuvem, com controle total sobre endereçamento IP, DNS, roteamento e gateways de segurança.",
      "category": "networking",
      "tags": ["azure", "networking", "vnet"],
      "estimatedDuration": "~45 segundos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome da VNet",
          "type": "string",
          "required": true,
          "placeholder": "vnet-meu-projeto-prod",
          "validation": { "pattern": "^vnet-[a-z0-9-]+$", "minLength": 5, "maxLength": 64 }
        },
        {
          "key": "address_space",
          "label": "Espaço de Endereçamento (CIDR)",
          "type": "string",
          "required": true,
          "placeholder": "10.0.0.0/16",
          "description": "Ex: 10.0.0.0/16",
          "validation": { "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$" }
        },
        {
          "key": "resource_group",
          "label": "Resource Group",
          "type": "string",
          "required": true,
          "placeholder": "rg-meu-projeto-prod"
        },
        {
          "key": "enable_ddos",
          "label": "Habilitar proteção DDoS",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        }
      ]
    },
    {
      "id": "aws-s3-bucket",
      "providerId": "aws",
      "name": "S3 Bucket",
      "shortDescription": "Crie um bucket S3 para armazenamento de objetos com controle de acesso e versionamento.",
      "longDescription": "## S3 Bucket\n\nO **Amazon S3** é o serviço de armazenamento de objetos da AWS com durabilidade de 99.999999999%. Ideal para backups, assets, data lakes e hospedagem de sites estáticos.",
      "category": "storage",
      "tags": ["aws", "s3", "storage", "objetos"],
      "estimatedDuration": "~20 segundos",
      "parameters": [
        {
          "key": "bucket_name",
          "label": "Nome do Bucket",
          "type": "string",
          "required": true,
          "placeholder": "minha-empresa-dados-prod",
          "description": "Único globalmente. Somente letras minúsculas, números e hífens.",
          "validation": { "pattern": "^[a-z0-9-]{3,63}$", "minLength": 3, "maxLength": 63 }
        },
        {
          "key": "region",
          "label": "Região",
          "type": "select",
          "required": true,
          "options": ["us-east-1", "us-west-2", "sa-east-1", "eu-west-1"],
          "defaultValue": "sa-east-1"
        },
        {
          "key": "versioning",
          "label": "Habilitar versionamento",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        },
        {
          "key": "access",
          "label": "Controle de Acesso",
          "type": "select",
          "required": true,
          "options": ["private", "public-read", "authenticated-read"],
          "defaultValue": "private"
        }
      ]
    },
    {
      "id": "aws-ec2-instance",
      "providerId": "aws",
      "name": "EC2 Instance",
      "shortDescription": "Lance uma instância EC2 com tipo, AMI e configurações de rede customizáveis.",
      "longDescription": "## EC2 Instance\n\nO **Amazon EC2** fornece capacidade computacional escalável na nuvem. Escolha entre centenas de tipos de instância otimizados para diferentes workloads.",
      "category": "compute",
      "tags": ["aws", "ec2", "compute", "vm"],
      "estimatedDuration": "~2 minutos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome da Instância",
          "type": "string",
          "required": true,
          "placeholder": "minha-app-prod-01",
          "validation": { "minLength": 3, "maxLength": 64 }
        },
        {
          "key": "instance_type",
          "label": "Tipo de Instância",
          "type": "select",
          "required": true,
          "options": ["t3.micro", "t3.small", "t3.medium", "t3.large", "m5.large", "c5.large"],
          "defaultValue": "t3.medium"
        },
        {
          "key": "ami",
          "label": "AMI",
          "type": "select",
          "required": true,
          "options": ["Amazon Linux 2023", "Ubuntu 22.04 LTS", "Windows Server 2022"],
          "defaultValue": "Amazon Linux 2023"
        },
        {
          "key": "region",
          "label": "Região",
          "type": "select",
          "required": true,
          "options": ["us-east-1", "us-west-2", "sa-east-1"],
          "defaultValue": "sa-east-1"
        },
        {
          "key": "disk_size_gb",
          "label": "Tamanho do Disco (GB)",
          "type": "number",
          "required": true,
          "defaultValue": "30",
          "validation": { "min": 8, "max": 16384 }
        }
      ]
    },
    {
      "id": "aws-rds-instance",
      "providerId": "aws",
      "name": "RDS Instance",
      "shortDescription": "Provisione um banco de dados gerenciado com suporte a MySQL, PostgreSQL e outros engines.",
      "longDescription": "## RDS Instance\n\nO **Amazon RDS** facilita a configuração, operação e escalabilidade de bancos de dados relacionais na nuvem. Backups automáticos, patches e alta disponibilidade inclusos.",
      "category": "database",
      "tags": ["aws", "rds", "database", "sql"],
      "estimatedDuration": "~5 minutos",
      "parameters": [
        {
          "key": "identifier",
          "label": "Identificador da Instância",
          "type": "string",
          "required": true,
          "placeholder": "meu-db-prod",
          "validation": { "pattern": "^[a-z][a-z0-9-]{0,62}$", "minLength": 2, "maxLength": 63 }
        },
        {
          "key": "engine",
          "label": "Engine",
          "type": "select",
          "required": true,
          "options": ["postgres", "mysql", "mariadb", "sqlserver-se"],
          "defaultValue": "postgres"
        },
        {
          "key": "instance_class",
          "label": "Classe da Instância",
          "type": "select",
          "required": true,
          "options": ["db.t3.micro", "db.t3.small", "db.t3.medium", "db.m5.large"],
          "defaultValue": "db.t3.medium"
        },
        {
          "key": "storage_gb",
          "label": "Armazenamento (GB)",
          "type": "number",
          "required": true,
          "defaultValue": "20",
          "validation": { "min": 20, "max": 65536 }
        },
        {
          "key": "multi_az",
          "label": "Habilitar Multi-AZ",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        }
      ]
    },
    {
      "id": "oci-compute-instance",
      "providerId": "oci",
      "name": "Compute Instance",
      "shortDescription": "Lance uma VM de alto desempenho na OCI com shapes flexíveis e bare metal disponíveis.",
      "longDescription": "## Compute Instance\n\nAs instâncias de compute da **Oracle Cloud Infrastructure** oferecem desempenho bare-metal com shapes flexíveis. Ideal para workloads críticos e aplicações que exigem latência ultra-baixa.",
      "category": "compute",
      "tags": ["oci", "compute", "vm", "bare-metal"],
      "estimatedDuration": "~3 minutos",
      "parameters": [
        {
          "key": "display_name",
          "label": "Nome da Instância",
          "type": "string",
          "required": true,
          "placeholder": "instance-producao-01",
          "validation": { "minLength": 3, "maxLength": 64 }
        },
        {
          "key": "shape",
          "label": "Shape",
          "type": "select",
          "required": true,
          "options": ["VM.Standard.E4.Flex", "VM.Standard3.Flex", "BM.Standard.E4.128", "VM.Optimized3.Flex"],
          "defaultValue": "VM.Standard.E4.Flex"
        },
        {
          "key": "ocpus",
          "label": "Número de OCPUs",
          "type": "number",
          "required": true,
          "defaultValue": "2",
          "validation": { "min": 1, "max": 64 }
        },
        {
          "key": "memory_gb",
          "label": "Memória (GB)",
          "type": "number",
          "required": true,
          "defaultValue": "16",
          "validation": { "min": 1, "max": 1024 }
        },
        {
          "key": "region",
          "label": "Região",
          "type": "select",
          "required": true,
          "options": ["sa-saopaulo-1", "us-ashburn-1", "eu-frankfurt-1"],
          "defaultValue": "sa-saopaulo-1"
        }
      ]
    },
    {
      "id": "oci-object-storage",
      "providerId": "oci",
      "name": "Object Storage Bucket",
      "shortDescription": "Armazenamento de objetos escalável e durável na OCI com tiers de acesso configuráveis.",
      "longDescription": "## Object Storage Bucket\n\nO **OCI Object Storage** oferece armazenamento de objetos altamente escalável com durabilidade de 11 noves. Suporte a tiers Standard e Archive para otimização de custos.",
      "category": "storage",
      "tags": ["oci", "storage", "objetos"],
      "estimatedDuration": "~30 segundos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome do Bucket",
          "type": "string",
          "required": true,
          "placeholder": "meu-bucket-dados",
          "validation": { "minLength": 3, "maxLength": 63 }
        },
        {
          "key": "namespace",
          "label": "Namespace",
          "type": "string",
          "required": true,
          "placeholder": "minha-empresa",
          "description": "Namespace do seu tenancy OCI"
        },
        {
          "key": "storage_tier",
          "label": "Tier de Armazenamento",
          "type": "select",
          "required": true,
          "options": ["Standard", "Archive"],
          "defaultValue": "Standard"
        },
        {
          "key": "versioning",
          "label": "Habilitar versionamento",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        }
      ]
    }
  ]
}
