{
  "providers": [
    {
      "id": "vmware",
      "name": "VMware vSphere",
      "shortName": "VMware",
      "logoUrl": "",
      "accentColor": "#1B9C2E",
      "description": "Virtualização enterprise com vSphere para workloads críticos e ambientes híbridos."
    }
  ],
  "offers": [
    {
      "id": "vmware-virtual-machine",
      "providerId": "vmware",
      "name": "Virtual Machine",
      "shortDescription": "Provisione uma VM no cluster vSphere com configurações de CPU, memória e disco customizáveis.",
      "longDescription": "## Virtual Machine\n\nCrie máquinas virtuais no ambiente **VMware vSphere** com controle total sobre CPU, memória, disco e rede. Suporte a templates corporativos e integração com vCenter.",
      "category": "compute",
      "tags": ["vmware", "vm", "vsphere", "compute"],
      "estimatedDuration": "~3 minutos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome da VM",
          "type": "string",
          "required": true,
          "placeholder": "vm-app-prod-01",
          "description": "Siga o padrão vm-{app}-{ambiente}-{seq}",
          "validation": { "pattern": "^vm-[a-z0-9-]+$", "minLength": 5, "maxLength": 64 }
        },
        {
          "key": "template",
          "label": "Template",
          "type": "select",
          "required": true,
          "options": ["Ubuntu 22.04 LTS", "RHEL 9", "Windows Server 2022", "Debian 12"],
          "defaultValue": "Ubuntu 22.04 LTS"
        },
        {
          "key": "cpu",
          "label": "vCPUs",
          "type": "number",
          "required": true,
          "defaultValue": "2",
          "validation": { "min": 1, "max": 64 }
        },
        {
          "key": "memory_gb",
          "label": "Memória (GB)",
          "type": "number",
          "required": true,
          "defaultValue": "4",
          "validation": { "min": 1, "max": 512 }
        },
        {
          "key": "disk_gb",
          "label": "Disco (GB)",
          "type": "number",
          "required": true,
          "defaultValue": "50",
          "validation": { "min": 20, "max": 4096 }
        },
        {
          "key": "cluster",
          "label": "Cluster vSphere",
          "type": "select",
          "required": true,
          "options": ["cluster-prod", "cluster-dev", "cluster-dmz"],
          "defaultValue": "cluster-prod"
        }
      ]
    },
    {
      "id": "vmware-virtual-network",
      "providerId": "vmware",
      "name": "Virtual Network (vSwitch)",
      "shortDescription": "Crie um portgroup ou vSwitch distribuído no ambiente vSphere com segmentação VLAN.",
      "longDescription": "## Virtual Network\n\nConfigure redes virtuais no **VMware vSphere** com portgroups, segmentação por VLAN e políticas de QoS. Integração com NSX-T disponível para ambientes avançados.",
      "category": "networking",
      "tags": ["vmware", "networking", "vswitch", "vlan"],
      "estimatedDuration": "~1 minuto",
      "parameters": [
        {
          "key": "name",
          "label": "Nome do Portgroup",
          "type": "string",
          "required": true,
          "placeholder": "pg-app-prod-100",
          "validation": { "pattern": "^pg-[a-z0-9-]+$", "minLength": 4, "maxLength": 64 }
        },
        {
          "key": "vlan_id",
          "label": "VLAN ID",
          "type": "number",
          "required": true,
          "description": "ID da VLAN (1-4094). Use 0 para sem VLAN.",
          "validation": { "min": 0, "max": 4094 }
        },
        {
          "key": "dvs",
          "label": "vSwitch Distribuído",
          "type": "select",
          "required": true,
          "options": ["dvs-producao", "dvs-desenvolvimento", "dvs-dmz"],
          "defaultValue": "dvs-producao"
        },
        {
          "key": "promiscuous",
          "label": "Modo promíscuo",
          "type": "boolean",
          "required": false,
          "defaultValue": "false"
        }
      ]
    },
    {
      "id": "vmware-datastore",
      "providerId": "vmware",
      "name": "Datastore NFS",
      "shortDescription": "Monte um datastore NFS no cluster vSphere para armazenamento compartilhado de VMs.",
      "longDescription": "## Datastore NFS\n\nProvisione e registre um **datastore NFS** no ambiente vSphere para armazenamento compartilhado entre hosts do cluster. Ideal para migração vMotion e alta disponibilidade.",
      "category": "storage",
      "tags": ["vmware", "storage", "nfs", "datastore"],
      "estimatedDuration": "~2 minutos",
      "parameters": [
        {
          "key": "name",
          "label": "Nome do Datastore",
          "type": "string",
          "required": true,
          "placeholder": "ds-nfs-prod-01",
          "validation": { "minLength": 4, "maxLength": 64 }
        },
        {
          "key": "nfs_server",
          "label": "Servidor NFS (IP ou hostname)",
          "type": "string",
          "required": true,
          "placeholder": "192.168.10.50",
          "description": "Endereço do servidor NFS acessível pelos hosts ESXi"
        },
        {
          "key": "nfs_path",
          "label": "Caminho NFS",
          "type": "string",
          "required": true,
          "placeholder": "/exports/vmware/prod",
          "validation": { "pattern": "^/[a-zA-Z0-9/_-]+$" }
        },
        {
          "key": "cluster",
          "label": "Cluster vSphere",
          "type": "select",
          "required": true,
          "options": ["cluster-prod", "cluster-dev", "cluster-dmz"],
          "defaultValue": "cluster-prod"
        }
      ]
    }
  ]
}
